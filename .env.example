# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# ── 服务端（只在 server 进程里用，不会进客户端包）────────────────────────────
# DeepSeek：https://platform.deepseek.com/api_keys
# 注意：这里要填你真实申请到的 key，不要保留下面的占位符
DEEPSEEK_API_KEY=sk-e2a8487cdf244e18a41a1e53b9ee9f4f

# 模型：deepseek-flash 就是 DeepSeek-V4.1-Flash-1017，官方 ID 只有这一个
AGENT_MODEL=deepseek-flash
# 更贵更强的版本：AGENT_MODEL=deepseek-v4-pro
#
# 思考模式：deepseek-flash 默认开启，抽取任务不需要（更慢更贵，且会无视 temperature）。
# 服务默认已关；确实想要思考链时打开这行：
# AGENT_THINKING=enabled

# 或者用任意 OpenAI 兼容端点（此时不需要上面的 DEEPSEEK_API_KEY）：
# OPENAI_API_KEY=sk-xxxxxxxx
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4o-mini

# 端点不支持 response_format 时关掉 JSON Output（服务端也会自动降级重试）
# AGENT_JSON_MODE=off

# 没有密钥时也能跑通链路（返回固定 JSON，不调用模型）
# AGENT_PROVIDER=stub

PORT=8787
HOST=127.0.0.1
AGENT_TZ=Asia/Shanghai

# ── 客户端（EXPO_PUBLIC_ 前缀会被注入到 App，只放公开信息）──────────────────
# 手机真机调试时改成电脑的局域网 IP，例如 http://192.168.1.8:8787
EXPO_PUBLIC_AGENT_API_URL=http://127.0.0.1:8787
